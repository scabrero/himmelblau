#!/bin/sh
set -e

is_debian_family() {
    (
        for f in /etc/os-release /usr/lib/os-release; do
            if [ -r "$f" ]; then
                . "$f"
                break
            fi
        done
        case " ${ID:-} ${ID_LIKE:-} " in
            *" debian "*|*" ubuntu "*) exit 0 ;;
        esac
        exit 1
    )
}

if [ -d /run/systemd/system ]; then
    if is_debian_family; then
        if [ -z "$DPKG_ROOT" ] && [ "$1" = remove ]; then
            deb-systemd-invoke daemon-reload --user >/dev/null || true
        fi
    elif command -v systemctl >/dev/null 2>&1; then
        # Make the user managers forget the removed unit files
        systemctl kill --kill-whom='main' --signal='SIGRTMIN+25' 'user@*.service' || true
    fi
fi
