#!/bin/sh
set -e

is_debian_family() {
    (
        for f in /etc/os-release /usr/lib/os-release; do
            if [ -r "$f" ]; then
                . "$f"
                break
            fi
        done
        case " ${ID:-} ${ID_LIKE:-} " in
            *" debian "*|*" ubuntu "*) exit 0 ;;
        esac
        exit 1
    )
}

if is_debian_family; then
    if [ -d /run/systemd/system ]; then
        if [ -z "$DPKG_ROOT" ] && [ "$1" = remove ]; then
            deb-systemd-invoke stop himmelblaud.service himmelblaud-tasks.service himmelblau-hsm-pin-init.service >/dev/null || true
        fi
    fi

    # Globally disable user timer on package removal (not during upgrades)
    if [ "$1" = remove ] || [ "$1" = purge ]; then
        deb-systemd-helper --user disable himmelblau-compliance-check.timer >/dev/null || true
    fi
else
    # Only on package removal, not during upgrades
    if [ "${1:-1}" -eq 0 ]; then
        if [ -d /run/systemd/system ]; then
            systemctl --no-reload disable --now himmelblaud.service himmelblaud.socket himmelblaud-tasks.service himmelblaud-tasks.socket himmelblaud-broker.socket himmelblau-hsm-pin-init.service >/dev/null 2>&1 || :
        else
            systemctl --no-reload disable himmelblaud.service himmelblaud.socket himmelblaud-tasks.service himmelblaud-tasks.socket himmelblaud-broker.socket himmelblau-hsm-pin-init.service >/dev/null 2>&1 || :
        fi
        systemctl --global disable himmelblau-compliance-check.timer >/dev/null 2>&1 || :
    fi
fi
